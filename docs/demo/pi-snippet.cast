b[39m\u001b]8;;\u001b\\?                                                   \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[38;2;138;190;183m3. \u001b[39m\u001b]8;;pisnip://vm/3086be92/2dcfd246/c3\u001b\\\u001b[38;2;129;162;190m\u001b[4m³Teach the dragon to do taxes instead\u001b[24m\u001b[39m\u001b]8;;\u001b\\?                                                          \u001b[0m\u001b]8;;\u0007\r\r\n                                                                                                    \u001b[0m\u001b]8;;\u0007\r\r\n Also, the tavern keeper wants to know: should I \u001b]8;;pisnip://vm/3086be92/2dcfd246/c4\u001b\\\u001b[38;2;129;162;190m\u001b[4m⁴put anchovies on it\u001b[24m\u001b[39m\u001b]8;;\u001b\\, or \u001b]8;;pisnip://vm/3086be92/2dcfd246/c5\u001b\\\u001b[38;2;129;162;190m\u001b[4m⁵absolutely not, never\u001b[24m\u001b]8;;\u001b\\    \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[4;38;2;129;162;190m\u001b]8;;pisnip://vm/3086be92/2dcfd246/c5\u001b\\again\u001b[24m\u001b[39m\u001b]8;;\u001b\\?                                                                                             \u001b[0m\u001b]8;;\u0007\r\r\n                                                                                                    \u001b[0m\u001b]8;;\u0007\r\r\n One more thing —"]
